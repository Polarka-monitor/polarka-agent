# systemd unit for a public faucet. It listens on this machine only; a web server in front provides HTTPS.
[Unit]
Description=Polarka faucet (polarka-agent faucet-serve)
After=network-online.target
Wants=network-online.target

[Service]
User=faucet
Group=faucet
ExecStart=/opt/polarka-faucet/venv/bin/polarka-agent --dir /var/lib/polarka-faucet/wallet faucet-serve --amount 0.25 --listen 127.0.0.1:8660 --trust-proxy
Restart=on-failure
RestartSec=10
# exit 2 is a refusal to start (limits, journal): starting again changes nothing, a person has to look
RestartPreventExitStatus=2
# the service may write its wallet folder and nothing else
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/polarka-faucet
MemoryMax=300M
TasksMax=200
LimitNOFILE=4096
# the same hardening as the pool's (human review, 22 November)
CapabilityBoundingSet=
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
