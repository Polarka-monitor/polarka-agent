# The postage gate. Its wallet only receives; it has no limits.json and so can pay nothing.
# --public-url and --offers: the 402 names the resource in full and describes the routes in offers.json
# (the bazaar extension of x402), so that the facilitator can list what was paid for here.
# No IPAddressDeny: for --price-hashes the gate asks api.northboundwallet.org how hard the network is to mine.
[Unit]
Description=Polarka postage gate (polarka-agent postage-serve)
After=network-online.target polarka-facts.service polarka-x402.service polarka-stamps.service
Wants=network-online.target

[Service]
User=gate
Group=gate
ExecStart=/opt/polarka-gate/venv/bin/polarka-agent --dir /var/lib/polarka-gate/wallet postage-serve --upstream 127.0.0.1:8680 --price-hashes 600 --calls 100 --free 20 --listen 127.0.0.1:8670 --trust-proxy --x402-facilitator http://127.0.0.1:9570 --route /v1/stamp=127.0.0.1:8681 --route /v1/mail=127.0.0.1:8682 --public-url https://gate.polarka.org --offers /etc/polarka-gate/offers.json
Restart=on-failure
RestartSec=10
# exit 2 is a refusal to start (limits, journal): starting again changes nothing, a person has to look
RestartPreventExitStatus=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/polarka-gate
MemoryMax=300M
TasksMax=200
# the same hardening as the pool's (human review, 22 November)
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
