# gate.polarka.org: the postage gate, the read-only part of the gate's own x402 facilitator beside it, and (from
# polarka-agent 0.2.3) a facilitator for sellers from outside.
# Only with polarka-agent 0.2.2 or later (httpguard.py): before it, a GET with a body carried a second request to
# the facilitator's /settle (review 8, H1). keepalive off keeps any upstream from reading such bytes as a request,
# and request_buffers has the whole (small) request read before an upstream sees it.
# /x402: only GET of supported and discovery/{resources,search} reaches the gate's own facilitator (9570), without
# the /x402 in front; its /verify and /settle (POST) stay on loopback, for the gate alone.
# /facilitator: supported, verify and settle reach the facilitator for sellers from outside (9571, a process of its
# own: deploy/x402/polarka-x402-public.service), without the /facilitator in front. Caddy writes the caller's
# address into X-Forwarded-For in place of whatever the caller sent (there are no trusted_proxies here), and that
# facilitator counts requests by it. A body may be 64 KB there (a payment with many inputs), 8 KB everywhere else.
# Everything else goes to the gate.
# Check with `caddy validate --config /etc/caddy/Caddyfile` before reloading.
gate.polarka.org {
	@facilitator {
		method GET
		path /x402/supported /x402/discovery/resources /x402/discovery/search
	}
	handle @facilitator {
		request_body {
			max_size 8KB
		}
		uri strip_prefix /x402
		reverse_proxy 127.0.0.1:9570 {
			transport http {
				keepalive off
			}
			request_buffers 8KB
		}
	}
	@outside {
		method GET POST
		path /facilitator/supported /facilitator/verify /facilitator/settle
	}
	handle @outside {
		request_body {
			max_size 64KB
		}
		uri strip_prefix /facilitator
		reverse_proxy 127.0.0.1:9571 {
			transport http {
				keepalive off
			}
			request_buffers 64KB
		}
	}
	handle {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:8670 {
			transport http {
				keepalive off
			}
			request_buffers 8KB
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output discard
	}
}
