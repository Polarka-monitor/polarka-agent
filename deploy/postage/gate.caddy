# gate.polarka.org: the postage gate, and the read-only part of the x402 facilitator beside it.
# Only with polarka-agent 0.2.2 or later (httpguard.py): before it, a GET with a body carried a second request to
# the facilitator's /settle (review 8, H1). keepalive off keeps any upstream from reading such bytes as a request.
# Only GET of /x402/supported and /x402/discovery/{resources,search} reaches the facilitator, without the
# /x402 in front; its /verify and /settle (POST) stay on loopback. Everything else goes to the gate.
# Check with `caddy validate --config /etc/caddy/Caddyfile` before reloading.
gate.polarka.org {
	request_body {
		max_size 8KB
	}
	@facilitator {
		method GET
		path /x402/supported /x402/discovery/resources /x402/discovery/search
	}
	handle @facilitator {
		uri strip_prefix /x402
		reverse_proxy 127.0.0.1:9570 {
			transport http {
				keepalive off
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8670 {
			transport http {
				keepalive off
			}
		}
	}
	log {
		output discard
	}
}
